POSTGRES_USER=mediabridge
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mediabridge

DATABASE_URL=postgresql+psycopg://mediabridge:changeme@db:5432/mediabridge

MOVIES_ROOT=/mnt/Movies

# Host-side folder bind-mounted into web/worker at the container path /mnt,
# and the root the Settings browse-folder dialog is confined to. Normally set
# via `./setup.sh --configure-media` (which also creates the directory), not
# hand-edited - see docs/setup.md. ./mnt_ro keeps exposure to a project-local
# folder; pointing this at a host path like /mnt (a typical Linux-server
# mount point for external drives) is a reasonable choice too, but exposes
# whatever else lives there; / is strongly discouraged - it exposes the
# entire host filesystem to the storage-location browser. (This FILESYSTEM_ROOT
# value is a *host* path and independent of the container's own /mnt mount
# point above - they're unrelated uses of the same name.)
FILESYSTEM_ROOT=./mnt_ro

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-char-hex-string

RABBITMQ_DEFAULT_USER=mediabridge
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
RABBITMQ_DEFAULT_PASS=replace-with-a-random-password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
TERMINATOR_API_KEY=replace-with-a-random-64-char-hex-string
SERVER_ADDRESS=
